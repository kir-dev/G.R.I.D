generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  authSchId String @id
  email     String @unique
}

model SessionType {
  id                 Int     @id @default(autoincrement())
  name               String
  length             Int // duration in minutes
  hasPoints          Boolean // true if points are awarded, false otherwise
  pointsForPositions Int[]
  seriesId           Int?
  // TODO referencia a Series-re, amikor a Series-t elkeszitjuk
}

model Driver {
  id          Int    @id @default(autoincrement())
  name        String
  point       Int
  seriesId    Int
  team        String
  nationality String
  //Todo series: Connect Driver to a Series
  //Todo Also prepare for future relation with Session
}
